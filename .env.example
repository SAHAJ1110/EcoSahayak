# ==============================================================================
# EcoSahayak (इको सहायक) — Environment Configuration Template
# ==============================================================================

# Supabase Authentication & PostgreSQL Database
# Retrieve from: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API for Multimodal Vision & Civic Intelligence
# Retrieve from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# Make.com (Integromat) Webhook for Automated Google Sheets Sync
# Retrieve from your Make.com Custom Webhook scenario trigger
VITE_MAKE_WEBHOOK_URL=https://hook.eu2.make.com/your-custom-webhook-hash

# Google Looker Studio Embed / Public Dashboard URL
VITE_LOOKER_STUDIO_URL=https://lookerstudio.google.com/embed/reporting/your-report-id/page/p_12345
